# Copie este arquivo para ".env" e preencha os valores reais:
#   cp .env.example .env
# O .env NÃO é versionado (contém a senha do banco).

# ===================== PostgreSQL =====================
POSTGRES_DB=loja
POSTGRES_USER=postgres
POSTGRES_PASSWORD=defina_uma_senha
POSTGRES_PORT=5432

# ===================== Backend (Spring Boot) =====================
# Host = nome do serviço do Postgres no docker-compose ("db"), não "localhost".
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/loja
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=defina_uma_senha
BACKEND_PORT=8080

# Origens liberadas no CORS (separe por vírgula, sem espaço)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ===================== Frontend (Vite) =====================
VITE_API_BASE_URL=http://localhost:8080/api
FRONTEND_PORT=5173
