# MODELO do arquivo de produção.
# No servidor: copie para ".env.prod" e preencha os valores reais.
#   cp .env.prod.example .env.prod
# O arquivo .env.prod NÃO é versionado (está no .gitignore) porque contém segredos.

# ===================== PostgreSQL =====================
POSTGRES_DB=loja
POSTGRES_USER=postgres
# Troque por uma senha forte (letras, números e símbolos). Sem aspas.
POSTGRES_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE

# ===================== Backend (Spring Boot) =====================
# Mesma origem do domínio com https (o front e a API ficam no mesmo endereço).
CORS_ALLOWED_ORIGINS=https://bbcarsound.com.br

# ===================== Acesso / Login (Caddy) =====================
# Domínio registrado na Hostinger, SEM "https://" e SEM barra no final.
SITE_ADDRESS=bbcarsound.com.br

# Usuário do login.
BASIC_AUTH_USER=lucas

# Hash da senha do Lucas. Gere assim (troque 'senha-forte-aqui'):
#   docker run --rm caddy caddy hash-password --plaintext 'senha-forte-aqui'
# Cole o resultado abaixo EXATAMENTE como sair (começa com $2a$...).
# Obs.: se o docker compose reclamar do "$", duplique cada $ (vira $$).
BASIC_AUTH_HASH=COLE_O_HASH_GERADO_AQUI
